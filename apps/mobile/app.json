{
  "expo": {
    "name": "FlipTheMeme",
    "slug": "flip-the-meme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100d1f",
    "scheme": "flipthememe",
    "android": {
      "package": "com.flipthememe.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0a0b0d"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sol.flipthememe.com",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100d1f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#b46cff" }],
      "./plugins/withNotificationFace",
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "network": "devnet"
    },
    "icon": "./assets/icon.png"
  }
}
