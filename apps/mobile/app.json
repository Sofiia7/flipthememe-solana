{
  "expo": {
    "name": "FlipTheMeme",
    "slug": "flip-the-meme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "flipthememe",
    "android": {
      "package": "com.flipthememe.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0b0d"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sol.flipthememe.com",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "network": "devnet",
      "apiBaseUrl": "http://10.0.2.2:8787"
    },
    "icon": "./assets/icon.png"
  }
}
