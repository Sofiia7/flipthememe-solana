{
  // Price attestor: the second signer of set_strike and settle, on infrastructure apart from the keeper.
  // It samples each round's PumpSwap pool on mainnet by itself during the strike and exit windows and
  // co-signs a price only when the keeper's samples agree with its own. See README.md.
  //
  // Secrets (wrangler secret put NAME, value on stdin):
  //   ATTESTOR_SECRET  required: base58 of the attestor's 64-byte Solana secret key, or of its 32-byte seed
  //   MAINNET_RPC      optional: keyed mainnet RPC URL, tried before publicnode
  //   DEVNET_RPC       optional: keyed devnet RPC URL, tried before OnFinality
  //   ATTEST_TOKEN     required in production: POST /v1/attest needs "Authorization: Bearer <token>"
  //                    (with none set the Worker accepts every caller; the keeper sends the same token)
  "name": "ftm-attestor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  // @solana/kit's workerd build imports node:events, node:fs/promises and node:path.
  "compatibility_flags": ["nodejs_compat"],
  // Public health at https://sol.flipthememe.com/v1/attestor (the route also covers POST /v1/attest);
  // a more specific route than the link Worker's sol.flipthememe.com/*. The keeper may keep using the
  // workers.dev URL: both reach the same Worker and the same Durable Object.
  // GET /v1/attestor is answered from the edge cache (caches.default) for 20 s, so polling it costs the
  // Durable Object one request per 20 s; the cache works on the custom domain only, not on workers.dev.
  "workers_dev": true,
  "routes": [{ "pattern": "sol.flipthememe.com/v1/attest*", "zone_name": "flipthememe.com" }],
  "vars": {
    // Largest gap between the keeper's mean price and the attestor's, in basis points of the attestor's.
    // Not calibrated yet: tighten it after a day of attests.maxDiffBps in GET /v1/attestor (see README.md).
    "ATTEST_TOLERANCE_BPS": "150",
    // Attempts per round and window (strike or exit) that reach the samples before the attestor answers
    // "too_many_attempts". Once a sample set is signed for a window, any other set is "already_signed".
    "ATTEST_MAX_TRIES": "6"
  },
  "durable_objects": {
    "bindings": [{ "name": "ATTESTOR", "class_name": "Attestor" }]
  },
  // SQLite-backed: the only Durable Object storage on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Attestor"] }],
  // Wakes the object every minute, so the sampling loop restarts after an eviction or a dropped alarm.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
